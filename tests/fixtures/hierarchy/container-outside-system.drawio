<mxfile host="drawio">
  <diagram id="d" name="Page-1">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object placeholders="1" c4Type="Software System" c4Name="Shop" c4Description="Sells things" label="%c4Name%" id="sys">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="40" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Container" c4Name="API" c4Description="Serves requests" c4Technology="Go" label="%c4Name%" id="api">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="400" y="40" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Description="Reads (id): item" c4Technology="HTTPS" label="%c4Description%" id="r">
          <mxCell style="endArrow=blockThin;html=1;endFill=1;metaEdit=1;" edge="1" parent="1" source="api" target="sys">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
