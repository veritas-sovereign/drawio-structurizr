<mxfile host="drawio">
  <diagram id="d" name="Page-1">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object placeholders="1" c4Type="SystemScopeBoundary" c4Name="Shop" label="%c4Name%" id="sys">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="20" y="20" width="600" height="300" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Component" c4Name="Order Service" c4Description="Takes orders" c4Technology="Go" label="%c4Name%" id="svc">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="60" y="80" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Container" c4Name="DB" c4Description="Stores orders" c4Technology="PostgreSQL" label="%c4Name%" id="db">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="340" y="80" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Description="Saves (order): id" c4Technology="SQL" label="%c4Description%" id="r">
          <mxCell style="endArrow=blockThin;html=1;endFill=1;metaEdit=1;" edge="1" parent="1" source="svc" target="db">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
