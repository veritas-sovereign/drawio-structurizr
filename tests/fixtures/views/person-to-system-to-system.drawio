<mxfile host="drawio">
  <diagram id="d" name="Page-1">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object placeholders="1" c4Type="Person" c4Name="Customer" c4Description="Buys" label="%c4Name%" id="user">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="40" width="200" height="180" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Software System" c4Name="Order &amp; Payment API" c4Description="Takes orders" label="%c4Name%" id="shop">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="400" y="40" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Software System" c4Name="Bank" c4Description="Moves money" label="%c4Name%" id="bank">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;metaEdit=1;" vertex="1" parent="1">
            <mxGeometry x="800" y="40" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Description="Orders" c4Technology="HTTPS" label="%c4Description%" id="r1">
          <mxCell style="endArrow=blockThin;html=1;endFill=1;metaEdit=1;" edge="1" parent="1" source="user" target="shop">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Type="Relationship" c4Description="Charge (order): receipt" c4Technology="ISO 20022" label="%c4Description%" id="r2">
          <mxCell style="endArrow=blockThin;html=1;endFill=1;metaEdit=1;" edge="1" parent="1" source="shop" target="bank">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
